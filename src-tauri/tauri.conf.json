{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "vellichor",
  "version": "0.1.0",
  "identifier": "com.skye.vellichor",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev:react",
    "beforeBuildCommand": "npm run build:react"
  },
  "app": {
    "windows": [
      {
        "title": "Vellichor",
        "width": 1150,
        "height": 780,
        "minWidth": 360,
        "minHeight": 540,
        "resizable": true,
        "center": true,
        "fullscreen": false,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: stream: http://stream.localhost; connect-src 'self' ipc: http://ipc.localhost stream: http://stream.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": ["$RESOURCE/**", "$APPDATA/**", "$HOME/.vellichor/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
  "resources":{
    "../assets/*": "assets/*"}
  }
}
