{
  "name": "vellichor",
  "version": "0.1.0",
  "description": "Vellichor is a cross-device control application that allows you to share screens and control devices between your phone and laptop bidirectionally",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm:dev:react\" \"npm:dev:tauri\"",
    "dev:react": "vite --host 0.0.0.0",
    "dev:types": "tsc --noEmit --watch",
    "dev:tauri": "tauri dev",
    "build": "npm run clean && npm run type-check && npm run build:react",
    "build:react": "vite build",
    "build:tauri": "tauri build",
    "package": "npm run build",
    "clean": "rimraf dist",
    "type-check": "tsc --noEmit",
    "tauri": "tauri",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,json,css}\"",
    "cert:gen": "keytool -genkey -v -keystore ~/vellichor-upload-keystore.jks -alias vellichor -keyalg RSA -keysize 2048 -validity 10000"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "^2.2.0",
    "@tauri-apps/plugin-opener": "^2.2.5",
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io-client": "^4.8.1",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.1",
    "@types/node": "^20.17.0",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.1.0"
  }
}
